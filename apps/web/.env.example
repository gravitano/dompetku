# =============================================================================
# DompetKu — contoh environment variables (lihat docs/project/03-ITA.md §7.3)
# Salin ke .env lalu sesuaikan. JANGAN commit file .env.
# =============================================================================

# --- App ---------------------------------------------------------------------
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
# Mode demo publik: "true" menampilkan kotak "Akun demo" (budi@example.com /
# Password123 dari `pnpm db:seed`) di halaman login. Dibaca di server saat
# runtime (bukan NEXT_PUBLIC_). Biarkan "false" untuk produksi sungguhan.
DEMO_MODE=false

# --- Database ----------------------------------------------------------------
# Sesuai service `db` di docker-compose.yaml
POSTGRES_USER=dompetku
POSTGRES_PASSWORD=dompetku
POSTGRES_DB=dompetku
DATABASE_URL=postgresql://dompetku:dompetku@localhost:5432/dompetku?schema=public

# --- Auth (better-auth) ------------------------------------------------------
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=ganti-dengan-string-acak-minimal-32-karakter
BETTER_AUTH_URL=http://localhost:3000

# --- Vercel ------------------------------------------------------------------
# Diisi otomatis oleh integrasi Neon (Vercel Marketplace):
#   DATABASE_URL           → pooled, dipakai runtime
#   DATABASE_URL_UNPOOLED  → koneksi langsung, dipakai prisma migrate/seed
# BETTER_AUTH_URL boleh dikosongkan di Vercel (fallback ke domain deployment).

# --- Backup (hanya di VPS, dipakai deploy/backup.sh) --------------------------
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
