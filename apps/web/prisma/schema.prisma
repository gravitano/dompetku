// Skema database DompetKu — lihat docs/project/03-ITA.md §4.
// Konvensi: model PascalCase, field camelCase, tabel & kolom snake_case via @@map/@map.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// better-auth (skema inti: user, session, account, verification)
// Nama model & field harus sama dengan skema better-auth (Prisma adapter).
// ---------------------------------------------------------------------------

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false) @map("email_verified")
  image         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  sessions     Session[]
  accounts     Account[]
  categories   Category[]
  transactions Transaction[]
  budgets      Budget[]

  @@map("users")
}

model Session {
  id        String   @id
  expiresAt DateTime @map("expires_at")
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verifications")
}

// ---------------------------------------------------------------------------
// Domain DompetKu
// ---------------------------------------------------------------------------

enum CategoryType {
  INCOME
  EXPENSE

  @@map("category_type")
}

model Category {
  id         String       @id @default(uuid()) @db.Uuid
  userId     String       @map("user_id")
  name       String       @db.VarChar(50)
  type       CategoryType
  icon       String?      @db.VarChar(50)
  isDefault  Boolean      @default(false) @map("is_default")
  archivedAt DateTime?    @map("archived_at")
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  budgets      Budget[]

  @@index([userId, type])
  @@map("categories")
}

model Transaction {
  id              String       @id @default(uuid()) @db.Uuid
  userId          String       @map("user_id")
  categoryId      String       @map("category_id") @db.Uuid
  type            CategoryType
  /// Nominal dalam Rupiah penuh (tanpa desimal).
  amount          BigInt
  transactionDate DateTime     @map("transaction_date") @db.Date
  note            String?      @db.VarChar(100)
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([userId, transactionDate])
  @@index([userId, categoryId, transactionDate])
  @@map("transactions")
}

model Budget {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id")
  categoryId  String   @map("category_id") @db.Uuid
  /// Tanggal 1 pada bulan anggaran.
  periodMonth DateTime @map("period_month") @db.Date
  /// Nominal dalam Rupiah penuh (tanpa desimal).
  amount      BigInt
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId, periodMonth])
  @@index([userId, periodMonth])
  @@map("budgets")
}
